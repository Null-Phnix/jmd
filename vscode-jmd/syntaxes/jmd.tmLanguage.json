{
  "scopeName": "source.jmd",
  "name": "JMD",
  "fileTypes": ["jmd"],
  "patterns": [
    { "include": "#meta" },
    { "include": "#characters" },
    { "include": "#lore" },
    { "include": "#body" },
    { "include": "#annotations" },
    { "include": "#revision" },
    { "include": "#annotation-markers" }
  ],
  "repository": {
    "meta": {
      "begin": "^@meta\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "match": "^\\s*(\\w+):\\s*(.+)$", "captures": {
          "1": { "name": "entity.name.tag.jmd.key" },
          "2": { "name": "string.quoted.jmd.value" }
        }}
      ]
    },
    "characters": {
      "begin": "^@characters\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "match": "^\\s*(\\w+):", "captures": {
          "1": { "name": "entity.name.class.jmd.character" }
        }},
        { "match": "\\{[^}]*\\}", "name": "meta.embedded.block.jmd.attrs" }
      ]
    },
    "lore": {
      "begin": "^@lore\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "match": "^\\s*(\\w+):", "captures": {
          "1": { "name": "entity.name.function.jmd.lore" }
        }},
        { "match": "(bifrost://[^\\s\"']+)", "name": "string.other.link.jmd.bifrost" }
      ]
    },
    "body": {
      "begin": "^@body\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "include": "#markdown" },
        { "include": "#annotation-markers" }
      ]
    },
    "annotations": {
      "begin": "^@annotations\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "match": "^\\s*(\\w+):$", "captures": {
          "1": { "name": "entity.name.tag.jmd.annid" }
        }},
        { "match": "^\\s*(type|author|status|created|text):", "captures": {
          "1": { "name": "markup.list.jmd.field" }
        }},
        { "match": "\\b(resolved)\\b", "name": "markup.inserted.jmd.status" },
        { "match": "\\b(unresolved)\\b", "name": "markup.deleted.jmd.status" }
      ]
    },
    "revision": {
      "begin": "^@revision\\b",
      "beginCaptures": { "0": { "name": "keyword.control.jmd.section" } },
      "end": "(?=^@\\w+)",
      "patterns": [
        { "match": "\\b(pass|timestamp|changes|ann_id|type|original|replacement|reason)\\b", "name": "keyword.other.jmd.revfield" }
      ]
    },
    "markdown": {
      "patterns": [
        { "match": "^#{1,6}\\s+.+$", "name": "markup.heading.jmd" },
        { "match": "\\*\\*(.+?)\\*\\*", "captures": { "1": { "name": "markup.bold.jmd" } } },
        { "match": "\\*(.+?)\\*", "captures": { "1": { "name": "markup.italic.jmd" } } },
        { "match": "`{3}\\w*\\n[\\s\\S]*?`{3}", "name": "markup.raw.block.jmd" },
        { "match": "`(.*?)`", "captures": { "1": { "name": "markup.raw.inline.jmd" } } }
      ]
    },
    "annotation-markers": {
      "patterns": [
        { "match": "\\[\\?\\s*([^:]+):([^:]+):([^:]+):([^\\]]+)\\]", "captures": {
          "0": { "name": "markup.annotation.jmd.open" },
          "1": { "name": "entity.name.tag.jmd.annid" },
          "2": { "name": "entity.name.type.jmd.anntype" },
          "3": { "name": "variable.parameter.jmd.author" },
          "4": { "name": "markup.deleted.jmd.status" }
        }},
        { "match": "\\[\\?\\]", "name": "markup.annotation.jmd.close" }
      ]
    }
  }
}
